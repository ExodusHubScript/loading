local stepPhrases = {
    "Loading core",
    "Initialising services",
    "Connecting to server",
    "Building interface",
    "Loading modules",
    "Compiling runtime",
    "Mounting assets",
    "Hooking input",
    "Preparing scripts",
    "Finalising",
}

local elapsed = 0
local lastStep = -1
local startTime = tick()

while true do
    task.wait(0.05)
    elapsed = tick() - startTime
    local progress = math.clamp(elapsed / DURATION, 0, 1)

    fill.Size = UDim2.new(progress, 0, 1, 0)
    if SHOW_PERCENT then
        pct.Text = math.floor(progress * 100) .. "%"
    end

    if SHOW_STEPS then
        local stepIdx = math.floor(progress * #stepPhrases) + 1
        if stepIdx > #stepPhrases then stepIdx = #stepPhrases end
        if stepIdx ~= lastStep then
            lastStep = stepIdx
            stepLbl.Text = stepPhrases[stepIdx] .. "..."
        end
    end

    if elapsed >= DURATION then break end
end

stepLbl.Text = "Ready"
stepLbl.TextColor3 = C.green
pct.Text = "100%"
task.wait(0.6)

TweenService:Create(root, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
    BackgroundTransparency = 1,
}):Play()
for _, d in ipairs(root:GetDescendants()) do
    pcall(function()
        if d:IsA("TextLabel") then
            TweenService:Create(d, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
        elseif d:IsA("Frame") then
            TweenService:Create(d, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
        elseif d:IsA("UIStroke") then
            TweenService:Create(d, TweenInfo.new(0.4), { Transparency = 1 }):Play()
        end
    end)
end
task.wait(0.55)
